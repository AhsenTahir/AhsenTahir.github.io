source 'https://rubygems.org'

group :jekyll_plugins do
  gem 'jekyll'
  gem 'jekyll-feed'
  gem 'jekyll-sitemap'
  gem 'jekyll-redirect-from'
  gem 'jemoji'
  gem 'webrick', '~> 1.8'
end

gem 'github-pages'
gem 'connection_pool', '2.5.0'

# Jekyll 3.9 (pinned by github-pages) still expects these to be default gems.
# Ruby 3.4+ unbundled them, so local builds need them declared explicitly.
# GitHub Pages builds on its own Ruby and ignores this, so it is local-only.
gem 'csv'
gem 'base64'
gem 'bigdecimal'
gem 'logger'
gem 'ostruct'
